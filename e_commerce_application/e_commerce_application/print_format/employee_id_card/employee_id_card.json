 "html": "<!--\n=====================================================================\n  ERPNext v15 Print Format: Premium Employee PVC ID Card (Vertical)\n  DocType: Employee\n  Print Format Type: Jinja\n  Size: CR80 Portrait (54mm x 86mm)\n  Page Order: FRONT = QR/Details Side | BACK = Photo Side\n=====================================================================\n-->\n\n<style>\n  /* ============ PAGE SETUP (CR80 CARD - PORTRAIT) ============ */\n @page{\n    size:54mm 86mm;\n    margin:0;\n}\n\n*{\n    margin:0;\n    padding:0;\n    box-sizing:border-box;\n}\n\n.id-card-page{\n    width:54mm;\n    height:86mm;\n    position:relative;\n    overflow:hidden;\n    page-break-after:always;\n    font-family:'Segoe UI',Arial,sans-serif;\n    background:#fff;\n}\n\n.id-card-page:last-child{\n    page-break-after:auto;\n}\n\n/*==========================\n FRONT\n===========================*/\n\n.card-front{\n\n    width:100%;\n    height:100%;\n    position:relative;\n    overflow:hidden;\n    border:.35mm solid #0b3d68;\n    border-radius:2.6mm;\n    background:#fff;\n\n}\n\n.company-tag{\n\n    position:absolute;\n\n    top:4mm;\n\n    right:3mm;\n\n    font-size:2mm;\n\n    font-weight:700;\n\n    color:#0b3d68;\n\n}\n\n.front-top{\n\n    padding:4mm 4mm 2mm 4mm;\n\n    position:absolute;\n\n    left:6mm;\n\n    top:3mm;\n\n    right:3mm;\n\n    z-index:20;\n\n}\n\n.employee-name{\n\n    font-size:4.8mm;\n\n    font-weight:900;\n\n    color:#111;\n\n    line-height:1;\n\n    text-transform:uppercase;\n\n    letter-spacing:.2px;\n\n}\n\n.name-underline{\n\n    width:18mm;\n\n    height:.7mm;\n\n    background:#0b3d68;\n\n    margin-top:1.2mm;\n\n    margin-bottom:1.4mm;\n\n}\n\n.blood-group{\n\n    font-size:2.4mm;\n\n    color:#555;\n\n    font-weight:600;\n\n}\n\n.blood-group span{\n\n    font-weight:800;\n\n    color:#0b3d68;\n\n}\n\n/* SAMPLE JAISA LEFT LOCATION */\n\n.vertical-location{\n\n    position:absolute;\n\n    left:-1.5mm;\n\n    top:30mm;\n\n    writing-mode:vertical-lr;\n\n    transform:none;\n\n    font-size:6.5mm;\n\n    font-weight:900;\n\n    color:#0b4f84;\n\n    letter-spacing:1px;\n\n    line-height:1;\n\n    z-index:20;\n\n}\n/* PHOTO */\n\n.photo-zone{\n\n    position:absolute;\n\n    left:8mm;\n\n    right:0;\n\n    top:22mm;\n\n    bottom:8mm;\n\n    overflow:hidden;\n\n    background:white;\n\n}\n\n.employee-photo{\n\n    width:100%;\n\n    height:100%;\n\n    object-fit:contain;\n\n    object-position:center bottom;\n\n    background:white;\n\n}\n\n.employee-photo-fallback{\n\n    width:100%;\n\n    height:100%;\n\n    display:flex;\n\n    justify-content:center;\n\n    align-items:center;\n\n    background:white;\n\n    color:#888;\n\n    font-weight:700;\n\n}\n.front-footer{\n\n    position:absolute;\n\n    bottom:0;\n\n    left:0;\n\n    width:100%;\n\n    height:8mm;\n\n    background:#0b3d68;\n\n    color:#fff;\n\n    display:flex;\n\n    align-items:center;\n\n    justify-content:center;\n\n    font-size:2.5mm;\n\n    font-weight:700;\n\n}\n\n/*==========================\n BACK SIDE\n===========================*/\n\n.card-back{\n\n    width:100%;\n    height:100%;\n\n    position:relative;\n\n    overflow:hidden;\n\n    border:.35mm solid #0b3d68;\n\n    border-radius:2.6mm;\n\n    background:#fff;\n\n    padding:3mm;\n\n    color:#23374d;\n\n}\n\n.back-title{\n\n    text-align:center;\n\n    font-size:2.9mm;\n\n    font-weight:900;\n\n    color:#0b3d68;\n\n    letter-spacing:.4px;\n\n    text-transform:uppercase;\n\n    padding-bottom:1mm;\n\n    border-bottom:.3mm solid #0b3d68;\n\n    margin-bottom:2mm;\n\n}\n\n.back-details td.label{\n\n    width:42%;\n\n    color:#0b3d68;\n\n    font-weight:700;\n\n    white-space:nowrap;\n\n}\n.back-details td{\n\n    padding:1mm 0;\n\n    font-size:2.15mm;\n\n    border-bottom:.15mm dotted #d6d6d6;\n\n    vertical-align:middle;\n\n}\n\n.back-details td.label{\n\n    width:20mm;\n\n    color:#0b3d68;\n\n    font-weight:700;\n\n}\n\n.back-details td.colon{\n\n    width:3mm;\n\n}\n\n.back-details td:last-child{\n\n    width:26mm;\n\n    text-align:left;\n\n    word-break:break-word;\n\n}\n\n/* QR */\n\n.qr-section{\n\n    text-align:center;\n\n    margin-top:0.8mm;\n\n}\n\n.qr-caption{\n\n    font-size:1.8mm;\n\n    font-weight:700;\n\n    color:#0b3d68;\n\n    margin-bottom:5mm;\n\n    text-transform:uppercase;\n\n}\n\n.qr-code-box{\n\n    width:15mm;\n    height:15mm;\n\n    margin:.5mm auto;\n\n    border:.25mm solid #000;\n\n    padding:.6mm;\n\n}\n\n.qr-code-box img{\n\n    width:100%;\n\n    height:100%;\n\n    object-fit:contain;\n\n}\n\n.qr-placeholder-text{\n\n    font-size:1.7mm;\n\n    color:#0b3d68;\n\n    text-align:center;\n\n    font-weight:700;\n\n}\n\n.qr-hint{\n\n    margin-top:.8mm;\n\n    font-size:1.6mm;\n\n    line-height:1.25;\n\n    color:#6d7d8d;\n\n}\n\n/* RETURN ADDRESS */\n\n.return-info{\n\n    margin-top:.8mm;\n\n    text-align:center;\n\n}\n\n.return-title{\n\n    font-size:1.95mm;\n\n    color:#0b3d68;\n\n    font-weight:700;\n\n    margin-bottom:.5mm;\n\n}\n\n.return-address{\n\n    font-size:1.75mm;\n\n    line-height:1.25;\n\n    color:#444;\n\n    padding:0 1mm;\n\n}\n\n/* FOOTER */\n\n.back-footer{\n\n    position:absolute;\n\n    left:0;\n\n    bottom:0;\n\n    width:100%;\n\n    padding:2mm 0;\n\n    background:#0b3d68;\n\n    color:#fff;\n\n    font-size:2.15mm;\n\n    font-weight:700;\n\n    text-align:center;\n\n}\n</style>\n\n\n<!-- ===================================================================\n     BACK SIDE\n==================================================================== -->\n\n<div class=\"id-card-page\">\n\n    <div class=\"card-back\">\n\n        <div class=\"back-title\">\n            EMPLOYEE DETAILS\n        </div>\n\n        <table class=\"back-details\">\n\n            <tr>\n                <td class=\"label\">Employee ID</td>\n                <td class=\"colon\">:</td>\n                <td>{{ doc.name }}</td>\n            </tr>\n\n            <tr>\n                <td class=\"label\">Phone</td>\n                <td class=\"colon\">:</td>\n                <td>{{ doc.cell_number or \"-\" }}</td>\n            </tr>\n\n            <tr>\n                <td class=\"label\">Email</td>\n                <td class=\"colon\">:</td>\n                <td style=\"word-break:break-word;\">\n                    {{ doc.company_email or \"-\" }}\n                </td>\n            </tr>\n\n            <tr>\n                <td class=\"label\">Emergency Contact No.</td>\n                <td class=\"colon\">:</td>\n                <td>{{ doc.emergency_phone_number or \"-\" }}</td>\n            </tr>\n            \n            <tr>\n                <td class=\"label\">Office Address</td>\n                <td class=\"colon\">:</td>\n                <td>\n                     <div style=\"min-height:5mm;\"></div>\n                </td>\n            </tr>\n\n        </table>\n\n        <!-- QR -->\n\n        <div class=\"qr-section\">\n\n            <div class=\"qr-caption\">\n                Scan QR to Save Contact\n            </div>\n\n            <div class=\"qr-code-box\">\n\n                {% if doc.custom_id_card_qr_code %}\n\n                    <img\n                        src=\"{{ doc.custom_id_card_qr_code }}\"\n                        alt=\"QR\">\n\n                {% else %}\n\n                    <div class=\"qr-placeholder-text\">\n                        QR<br>Generating...\n                    </div>\n\n                {% endif %}\n\n            </div>\n\n            \n        </div>\n\n        <!-- Address -->\n\n        <div class=\"return-info\">\n\n            <div class=\"return-title\">\n                If Found, Please Return To\n            </div>\n\n            <div class=\"return-address\">\n\n                <div style=\"\n                    min-height:4mm;\n                    width:100%;\n                \">\n                     &nbsp;\n                </div>\n\n            </div>\n\n        </div>\n\n        <div class=\"back-footer\">\n\n            {{ doc.website or \"www.company.com\" }}\n\n        </div>\n\n    </div>\n\n</div>\n<!-- ===================================================================\n     FRONT SIDE\n==================================================================== -->\n\n<div class=\"id-card-page\">\n\n    <div class=\"card-front\">\n\n        <!-- Company Name -->\n        <div class=\"company-tag\">\n            {{ doc.company or \"COMPANY\" }}\n        </div>\n\n        <!-- Vertical Location -->\n        <div class=\"vertical-location\">\n            {{ (doc.branch or doc.department or \"MUMBAI\") | upper }}\n        </div>\n\n        <!-- Name -->\n        <div class=\"front-top\">\n\n            <div class=\"employee-name\">\n\n                {{ doc.first_name }}\n\n            <br>\n\n                {{ doc.last_name }}\n\n            </div>\n\n            <div class=\"name-underline\"></div>\n\n            <div class=\"blood-group\">\n                Blood Group :\n                <span>{{ doc.blood_group or \"N/A\" }}</span>\n            </div>\n\n        </div>\n\n        <!-- Photo -->\n\n        <div class=\"photo-zone\">\n\n            {% if doc.image %}\n\n            <img\n                class=\"employee-photo\"\n                src=\"{{ doc.image }}\"\n                alt=\"Employee\">\n\n            {% else %}\n\n            <div class=\"employee-photo-fallback\">\n                NO PHOTO\n            </div>\n\n            {% endif %}\n\n        </div>\n\n        <!-- Bottom Strip -->\n\n        <div class=\"front-footer\">\n\n            Employee ID :\n            {{ doc.name }}\n\n        </div>\n\n    </div>\n\n</div>",
